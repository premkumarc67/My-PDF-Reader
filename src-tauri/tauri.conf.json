{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",

  "productName": "PDF Viewer",
  "version": "1.0.0",
  "identifier": "com.pdfviewer.desktop",

  "build": {
    "frontendDist": "../src"
  },

  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' blob: data:"
    },
    "windows": [
      {
        "title": "PDF Viewer",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "zoomHotkeysEnabled": true
      }
    ]
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}